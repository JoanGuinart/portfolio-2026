---
import Layout from "../layouts/Layout.astro";
import Profile from "../components/Profile.astro";
import ProjectCard from "../components/ProjectCard.astro";
import projectsData from "../data/projects.json";

const allProjects = projectsData.projects.filter(
  (project) => project.published !== false,
);
const recentProjects = allProjects.filter((project) => project.recent);
const previousProjects = allProjects.filter((project) => !project.recent);
---

<Layout
  title="Joan Guinart Portfolio"
  description="Welcome to my portfolio website, showcasing my projects and skills in web development. Explore my work and get in touch!"
  lang="en"
>
  <Profile />

  {recentProjects.map((project) => <ProjectCard project={project} />)}

  <!-- Hidden on 2xl: with 4 columns the recent group doesn't fill whole rows -->
  <h2
    class="col-span-full 2xl:hidden flex items-center gap-4 pt-6 pb-1 text-[11px] font-semibold uppercase tracking-[0.3em] text-white/50"
  >
    Previous work
    <span class="h-px flex-1 bg-white/15" aria-hidden="true"></span>
  </h2>

  {previousProjects.map((project) => <ProjectCard project={project} />)}
</Layout>
