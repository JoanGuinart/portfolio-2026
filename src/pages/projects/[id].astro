---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import projectsData from "../../data/projects.json";
import {
  buildImageSources,
  getProjectCategory,
  projectPath,
} from "../../utils/projectUtils";

export function getStaticPaths() {
  const published = projectsData.projects.filter(
    (project) => project.published !== false,
  );
  return published.map((project, i) => ({
    params: { id: project.id },
    props: {
      project,
      prev: published[i - 1] ?? null,
      next: published[i + 1] ?? null,
    },
  }));
}

const { project, prev, next } = Astro.props;

// Case study markdown is optional, so look it up without warning when missing
const entry = (await getCollection("projects")).find((e) => e.id === project.id);
const Content = entry ? (await render(entry)).Content : null;
const category = getProjectCategory(project);
const role = entry?.data.role ?? category?.role;

const { srcset } = buildImageSources(project.image);
const imageBase = project.image.replace(".webp", "");
const siteHost = new URL(project.demoUrl).hostname.replace(/^www\./, "");

const meta = [
  { label: "Role", value: role },
  // Skip client when it just repeats the project name (e.g. "Owner · BarPass")
  {
    label: "Client",
    value: project.client.includes(project.title) ? undefined : project.client,
  },
  { label: "Year", value: String(project.year) },
].filter((item) => item.value);
---

<Layout
  title={`${project.title} · Joan Guinart`}
  description={project.description ?? `${project.title} — ${project.client}`}
  ogImage={`/images/projects/${imageBase}-900.webp`}
  variant="page"
>
  <a
    href="/"
    class="inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.25em] text-white/60 hover:text-yellow-400 transition"
  >
    <span aria-hidden="true">←</span> All projects
  </a>

  <!-- Header -->
  <header class="mt-8 sm:mt-12">
    <p class="text-[11px] font-semibold uppercase tracking-[0.25em] text-yellow-400">
      {category?.label ?? project.client}
    </p>
    <h1 class="mt-3 text-4xl sm:text-6xl font-bold tracking-tight text-white leading-[1.02]">
      {project.title}
    </h1>
    {
      project.description && (
        <p class="mt-5 max-w-2xl text-base sm:text-lg leading-relaxed text-white/70">
          {project.description}
        </p>
      )
    }
    <a
      href={project.demoUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-7 inline-flex items-center gap-2 rounded-lg bg-yellow-400 px-5 py-3 text-xs font-semibold uppercase tracking-[0.2em] text-black hover:bg-yellow-300 transition"
    >
      Visit {siteHost} <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 8.5l5-5M4.5 3.5h4v4"/></svg>
    </a>
  </header>

  <!-- Meta -->
  <dl
    class="mt-10 grid grid-cols-2 sm:grid-cols-4 gap-x-6 gap-y-5 border-y border-white/10 py-6"
  >
    {
      meta.map(({ label, value }) => (
        <div>
          <dt class="text-[11px] font-semibold uppercase tracking-[0.2em] text-white/40">
            {label}
          </dt>
          <dd class="mt-1.5 text-sm text-white">{value}</dd>
        </div>
      ))
    }
    <div class="col-span-2 sm:col-span-1">
      <dt class="text-[11px] font-semibold uppercase tracking-[0.2em] text-white/40">
        Stack
      </dt>
      <dd class="mt-1.5 text-sm text-white">{project.technologies.join(", ")}</dd>
    </div>
  </dl>

  <!-- Screenshot -->
  <a
    href={project.demoUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="mt-10 block overflow-hidden rounded-lg bg-white ring-1 ring-white/10"
    aria-label={`Open ${project.title} (new tab)`}
  >
    <img
      src={`/images/projects/${imageBase}-900.webp`}
      srcset={srcset}
      sizes="(max-width: 1024px) 100vw, 1024px"
      alt={`Screenshot of ${project.title}`}
      class="w-full h-auto"
    />
  </a>

  <!-- Story -->
  {
    (Content || category) && (
      <article class="case-body mt-12 max-w-2xl">
        {Content ? (
          <Content />
        ) : (
          category?.paragraphs.map((text) => <p>{text}</p>)
        )}
      </article>
    )
  }

  <!-- Prev / next -->
  <nav
    class="mt-16 grid grid-cols-2 gap-4 border-t border-white/10 pt-8"
    aria-label="More projects"
  >
    {
      prev ? (
        <a href={projectPath(prev.id)} class="group">
          <span class="text-[11px] font-semibold uppercase tracking-[0.2em] text-white/40">
            ← Previous
          </span>
          <span class="mt-1 block text-white font-semibold group-hover:text-yellow-400 transition">
            {prev.title}
          </span>
        </a>
      ) : (
        <span />
      )
    }
    {
      next && (
        <a href={projectPath(next.id)} class="group text-right">
          <span class="text-[11px] font-semibold uppercase tracking-[0.2em] text-white/40">
            Next →
          </span>
          <span class="mt-1 block text-white font-semibold group-hover:text-yellow-400 transition">
            {next.title}
          </span>
        </a>
      )
    }
  </nav>
</Layout>

<style is:global>
  .case-body {
    color: rgb(255 255 255 / 0.75);
    font-size: 1.0625rem;
    line-height: 1.75;
  }
  .case-body h2 {
    margin: 2.5rem 0 0.75rem;
    color: #fff;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .case-body h2:first-child {
    margin-top: 0;
  }
  .case-body p + p {
    margin-top: 1rem;
  }
  .case-body ul {
    margin-top: 0.75rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .case-body li + li {
    margin-top: 0.5rem;
  }
  .case-body li::marker {
    color: #facc15;
  }
  .case-body strong {
    color: #fff;
    font-weight: 600;
  }
</style>
