---
import {
  buildImageSources,
  getTechToDisplay,
  CSS_CLASSES,
  projectPath,
} from "../utils/projectUtils";

const { project } = Astro.props;
const href = projectPath(project.id);
const { src, srcset } = buildImageSources(project.image);
const { displayed: displayedTechs, remaining: remainingTechs } =
  getTechToDisplay(project.technologies);
---

<div
  class="project-card-wrapper group cursor-pointer relative"
  data-project-card
>
  <div
    class="flip-card relative w-full rounded-lg overflow-hidden bg-white aspect-4/3"
  >
    <div
      class="flip-card-inner absolute inset-0 w-full h-full transition-transform duration-700"
    >
      <!-- Front -->
      <div
        class="flip-card-front absolute inset-0 w-full h-full rounded-lg overflow-hidden bg-white"
      >
        <a
          href={href}
          aria-label={`View ${project.title} project details`}
          class="block w-full h-full"
        >
          <img
            src={src}
            srcset={srcset}
            sizes="(max-width: 600px) 100vw, (max-width: 1200px) 50vw, 33vw"
            alt={`Screenshot of ${project.title}`}
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover object-top"
          />
        </a>

        {
          project.current && (
            <span class="pointer-events-none absolute top-3 left-3 z-10 flex items-center gap-1.5 rounded-full bg-yellow-400 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.15em] text-black shadow">
              <span class="w-1.5 h-1.5 rounded-full bg-black" aria-hidden="true" />
              Current
            </span>
          )
        }

        <!-- Desktop hover scrim so expanded details stay readable -->
        <div
          class="hidden lg:block pointer-events-none absolute inset-0 bg-black/0 transition-colors duration-300 group-hover:bg-black/55"
          aria-hidden="true"
        ></div>

        <!-- Caption: always visible, details expand on desktop hover -->
        <div
          class="pointer-events-none absolute inset-x-0 bottom-0 bg-linear-to-t from-black/90 via-black/60 to-transparent px-4 pb-4 pt-12 pr-16 lg:px-5 lg:pr-5 lg:pb-5"
        >
          <div class="flex items-baseline justify-between gap-3">
            <h3 class="text-white font-semibold text-base lg:text-lg leading-tight">
              {project.title}
            </h3>
            <span class="hidden lg:block text-white/60 text-xs tabular-nums">{project.year}</span>
          </div>
          <div
            class="hidden lg:grid grid-rows-[0fr] opacity-0 transition-all duration-300 group-hover:grid-rows-[1fr] group-hover:opacity-100"
          >
            <div class="overflow-hidden">
              {
                project.client !== project.title && (
                  <p class="text-white/80 text-sm mt-1">{project.client}</p>
                )
              }
              {
                project.description && (
                  <p class="text-white/70 text-xs mt-2 line-clamp-2">{project.description}</p>
                )
              }
              <div class="flex flex-wrap gap-2 mt-3">
                {displayedTechs.map((tech) => (
                  <span class={CSS_CLASSES.techTags.desktop}>{tech}</span>
                ))}
                {remainingTechs > 0 && (
                  <span class={CSS_CLASSES.techTags.desktop}>+{remainingTechs}</span>
                )}
              </div>
            </div>
          </div>
        </div>

        <!-- Mobile info button -->
        <button
          class={CSS_CLASSES.buttons.mobileInfo}
          data-flip-btn
          aria-label={`More info about ${project.title}`}
        >
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M12 7v10M7 12h10"
              stroke="white"
              stroke-width="2.2"
              stroke-linecap="round"></path>
          </svg>
        </button>
      </div>

      <!-- Back -->
      <div
        class="flip-card-back absolute inset-0 w-full h-full rounded-lg overflow-hidden bg-linear-to-br from-black to-gray-900"
      >
        <div
          class="flex flex-col justify-center items-center h-full p-6 text-center relative"
        >
          <h3 class="text-white font-bold text-xl mb-2">{project.title}</h3>
          <p class="text-white/85 text-sm mb-4">{project.client}</p>

          <!-- Tech tags -->
          <div class="flex flex-wrap gap-2 justify-center mb-6">
            {
              displayedTechs.map((tech) => (
                <span class={CSS_CLASSES.techTags.mobile}>{tech}</span>
              ))
            }
            {
              remainingTechs > 0 && (
                <span class={CSS_CLASSES.techTags.mobile}>
                  +{remainingTechs}
                </span>
              )
            }
          </div>

          <!-- Mobile buttons -->
          <div class="flex gap-3 mt-4">
            <a href={href} class={CSS_CLASSES.buttons.mobileLink}>
              View project
            </a>
            <a
              href={project.demoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class={CSS_CLASSES.buttons.mobileBack}
            >
              <span class="inline-flex items-center gap-1.5">Visit site <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 8.5l5-5M4.5 3.5h4v4"/></svg></span>
            </a>
          </div>
          <button
            class={CSS_CLASSES.buttons.mobileInfo}
            data-flip-back-btn
            aria-label="Back"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="#fff" width="15" height="15" viewBox="0 0 32 32" aria-hidden="true">
              <path d="M0 21.984q0.032-0.8 0.608-1.376l4-4q0.448-0.48 1.056-0.576t1.12 0.128 0.864 0.736 0.352 1.12v1.984h18.016q0.8 0 1.408-0.576t0.576-1.408v-8q0-0.832-0.576-1.408t-1.408-0.608h-16q-0.736 0-1.248-0.416t-0.64-0.992 0-1.152 0.64-1.024 1.248-0.416h16q2.464 0 4.224 1.76t1.76 4.256v8q0 2.496-1.76 4.224t-4.224 1.76h-18.016v2.016q0 0.64-0.352 1.152t-0.896 0.704-1.12 0.096-1.024-0.544l-4-4q-0.64-0.608-0.608-1.44z"/>
            </svg>
          </button>
        </div>
      </div>
    </div>

  </div>
</div>

<style>
  .flip-card {
    perspective: 1000px;
  }

  .flip-card-inner {
    transform-style: preserve-3d;
  }

  .flip-card-front,
  .flip-card-back {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .flip-card-back {
    transform: rotateY(180deg);
  }

  @media (max-width: 1024px) {
    .project-card-wrapper.flipped .flip-card-inner {
      transform: rotateY(180deg);
    }
  }

  @media (min-width: 1024px) {
    .project-card-wrapper {
      cursor: pointer;
    }
  }
</style>

<script>
  function initializeProjectCards() {
    const cards = document.querySelectorAll("[data-project-card]");

    cards.forEach((card) => {
      // Prevent multiple initializations
      if (card.hasAttribute("data-initialized")) return;
      card.setAttribute("data-initialized", "true");

      const flipBtn = card.querySelector("[data-flip-btn]");
      const flipBackBtn = card.querySelector("[data-flip-back-btn]");

      // Mobile/Tablet: flip functionality
      if (flipBtn) {
        flipBtn.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();

          // Keep only one card flipped at a time.
          cards.forEach((otherCard) => {
            if (otherCard !== card) {
              otherCard.classList.remove("flipped");
            }
          });

          card.classList.add("flipped");
        });
      }

      if (flipBackBtn) {
        flipBackBtn.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          card.classList.remove("flipped");
        });
      }
    });
  }

  // Initialize on load
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeProjectCards);
  } else {
    initializeProjectCards();
  }
</script>
