---

<section
  class="col-span-1 sm:col-span-2 lg:col-span-1 lg:row-span-2 flex flex-col rounded-lg bg-yellow-400 text-black overflow-hidden"
  aria-label="About Joan Guinart"
>
  <!-- Top bar -->
  <div
    class="flex items-center justify-between px-6 py-4 border-b border-black/15 text-[11px] font-semibold uppercase tracking-[0.25em]"
  >
    <span>Portfolio</span>
    <span class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-green-600 animate-pulse" aria-hidden="true"></span>
      Available for projects
    </span>
  </div>

  <!-- Main -->
  <div class="flex flex-1 flex-col justify-center gap-8 px-6 py-10 lg:px-8">
    <div>
      <h1 class="text-5xl sm:text-6xl font-bold leading-[0.95] tracking-tight">
        Joan<br />Guinart
      </h1>
      <p class="mt-4 text-sm font-semibold uppercase tracking-[0.25em]">
        Frontend Developer
      </p>
      <p class="mt-3 max-w-sm text-[15px] leading-relaxed text-black/75">
        Building fast, interactive web experiences with modern technologies.
      </p>
    </div>

    <!-- Current roles -->
    <div>
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.25em] text-black/60">
        Currently
      </p>
      <ul class="divide-y divide-black/15 border-y border-black/15">
        {
          currentRoles.map(({ company, role, url }) => (
            <li>
              <a
                href={url}
                class="flex items-baseline justify-between gap-4 py-2.5 hover:opacity-60 transition"
              >
                <span class="font-semibold">{company}</span>
                <span class="text-sm text-black/70">{role}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <!-- Footer: socials + CV -->
  <div
    class="flex flex-wrap items-center justify-between gap-4 px-6 py-4 border-t border-black/15"
  >
    <div class="flex gap-1">
      {
        socials.map(({ label, href, icon }) => (
          <a
            href={href}
            title={label}
            aria-label={label}
            target={href.startsWith("http") ? "_blank" : undefined}
            rel={href.startsWith("http") ? "noopener noreferrer" : undefined}
            class="w-10 h-10 flex items-center justify-center rounded hover:bg-black/10 transition"
            set:html={icon}
          />
        ))
      }
    </div>
    <a
      href="/cv/CV_Joan_Guinart_2026.pdf"
      download
      class="px-5 py-2.5 bg-black text-yellow-400 font-semibold rounded-lg hover:bg-black/80 transition text-xs tracking-[0.2em] uppercase"
    >
      Download CV
    </a>
  </div>
</section>
