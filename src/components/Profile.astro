---
/**
 * Profile Component
 * Yellow card displaying user info, social links, and CV download
 */
---

<div
  class="h-85 lg:h-full min-h-110 after:content relative col-span-1 row-span-3 sm:col-span-2 lg:col-span-1 lg:row-span-2 flex flex-col items-center justify-end gap-4 overflow-hidden rounded-lg bg-white/10 px-6 pb-16 pt-64 text-center text-white shadow-highlight after:pointer-events-none after:absolute after:inset-0 after:rounded-lg after:shadow-highlight lg:pt-0"
>
  <div
    class="absolute inset-0 flex flex-col items-center justify-between text-black bg-yellow-400"
  >
    <!-- Header with name -->
    <div class="w-full">
      <div class="relative bg-yellow-400 w-full h-full">
        <div
          class="w-full text-black py-5 flex border-b border-mainBackground justify-center items-center"
        >
          <h1 class="text-center uppercase font-semibold tracking-[0.3em] text-sm">
            Joan Guinart Casas
          </h1>
        </div>
      </div>
    </div>

    <!-- Main content -->
    <div
      class="bg-yellow-400 flex flex-col justify-center items-center w-full gap-6 py-8 px-6"
    >
      <!-- Avatar & Profile Info -->
      <div class="flex flex-col items-center gap-4">
        <div class="text-center">
          <p
            class="text-xs text-gray-900 max-w-xs leading-relaxed uppercase tracking-[0.18em] font-medium"
          >
            Building interactive web experiences with modern technologies
          </p>
        </div>

        <!-- Availability Badge -->
        <div
          class="flex items-center gap-2 bg-white bg-opacity-70 px-3 py-1.5 rounded-full text-xs font-medium"
        >
          <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
          <span class="text-black">Available for Projects</span>
        </div>
      </div>

      <!-- Social Links -->
      <div class="flex gap-2 flex-wrap justify-center">
        <a
          href="mailto:guinartcasasjoan@gmail.com"
          title="Email"
          class="w-10 h-10 flex items-center justify-center rounded hover:opacity-70 transition"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            ><path
              d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
            ></path><path d="m20 6-8 5-8-5"></path></svg
          >
        </a>
        <a
          href="https://wa.me/34617056810"
          target="_blank"
          title="WhatsApp"
          class="w-10 h-10 flex items-center justify-center rounded hover:opacity-70 transition"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"
            ><path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
            ></path></svg
          >
        </a>
        <a
          href="https://github.com/JoanGuinart"
          target="_blank"
          title="GitHub"
          class="w-10 h-10 flex items-center justify-center rounded hover:opacity-70 transition"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"
            ><path
              d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.6.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
            ></path></svg
          >
        </a>
        <a
          href="https://www.linkedin.com/in/joan-guinart-casas/"
          target="_blank"
          title="LinkedIn"
          class="w-10 h-10 flex items-center justify-center rounded hover:opacity-70 transition"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"
            ><path
              d="M20.447 20.452h-3.554v-5.569c0-1.328-.474-2.229-1.661-2.229-1.011 0-1.612.678-1.876 1.334-.096.231-.12.554-.12.877v5.587h-3.546v-9.131h3.546v1.25c.39-.6 1.087-1.454 2.64-1.454 1.929 0 3.376 1.261 3.376 3.975v5.36zM5.337 9.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 10.019H3.555V9.321h3.564v10.131zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"
            ></path></svg
          >
        </a>
      </div>

      <!-- CTA Button -->
      <a
        href="/cv/CV_Joan_Guinart_2026.pdf"
        download
        class="px-8 py-3 border border-black text-black font-semibold rounded-lg hover:bg-black hover:text-white transition duration-300 text-xs tracking-[0.25em] uppercase"
      >
        Download CV
      </a>
    </div>

    <!-- Footer with job title -->
    <div
      class="w-full px-5 bg-yellow-400 py-5 border-t border-mainBackground"
    >
      <h1
        class="text-nowrap leading-4.25 font-semibold uppercase tracking-[0.3em] text-xs"
      >
        Frontend Developer
      </h1>
    </div>
  </div>
</div>
